# Copy this file to `.env.production` on the VPS. Fill in the placeholders there.
# `.env.production` is gitignored. This example contains no real secrets.
#
# Generate the two secrets on the server and paste them only into `.env.production`:
#   python3 -c "import secrets; print(secrets.token_hex(24))"
#   python3 -c "import secrets; print(secrets.token_hex(48))"
# Use the hex strings as-is. A password with @, :, /, or # would have to be
# URL-encoded inside DATABASE_URL, and Compose builds that URL for you.
#
# Start the stack later with:
#   docker compose --env-file .env.production -f docker-compose.prod.yml up -d --build
# Do not put this file, or any value from it, in the Vercel project.

# Required. Unique database password. The development value finsight is rejected.
POSTGRES_PASSWORD=replace-with-a-unique-password

# Required. Random JWT signing secret, at least 32 characters.
JWT_SECRET_KEY=replace-with-a-random-secret-at-least-32-characters

# Required. Exact browser origins of the Vercel site, comma-separated, https only.
# A preview URL is a different origin and must be listed on its own.
CORS_ORIGINS=https://YOUR-PROJECT.vercel.app

# OpenRouter model. These stay on the API host.
AI_PROVIDER=openai
AI_OPENAI_API=chat
AI_BASE_URL=https://openrouter.ai/api/v1
AI_MODEL=openrouter/free
AI_API_KEY=
AI_TIMEOUT_SECONDS=120
AI_FALLBACK_TO_LOCAL=false

# Cited web research. A Tavily key stays on the API host.
WEB_RESEARCH_PROVIDER=tavily
WEB_RESEARCH_API_KEY=
WEB_RESEARCH_MAX_RESULTS=5
WEB_RESEARCH_TIMEOUT_SECONDS=15

# Personal-demo quotes and headlines. Finnhub's free plan is personal-use only.
QUOTE_PROVIDER=finnhub
PROVIDER_MARKS=false
NEWS_PROVIDER=finnhub
MARKET_DATA_PROVIDER=yahoo
MARKET_DATA_API_KEY=
FINNHUB_API_KEY=
